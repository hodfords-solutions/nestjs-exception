{
    "name": "@hodfords/nestjs-exception",
    "version": "12.3.0",
    "packageManager": "pnpm@12.0.0",
    "description": "A NestJS module for handling and customizing exceptions with ease.",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "tsc",
        "start:dev": "pnpm run prebuild && nest start --watch -p tsconfig.sample.json",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "prepare": "is-ci || husky",
        "format": "prettier --write \"lib/**/*.ts\"",
        "cspell": "cspell",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-exception.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-exception/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-exception#readme",
    "dependencies": {
        "@grpc/grpc-js": "1.14.4",
        "es-toolkit": "1.52.0"
    },
    "devDependencies": {
        "@hodfords/nestjs-cls-translation": "12.1.0",
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/node": "26.4.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "express": "5.2.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "typeorm": "1.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@hodfords/nestjs-cls-translation": ">=12.0.0",
        "@nestjs/common": ">=12.0.0",
        "rxjs": ">=7.0.0",
        "typeorm": ">=1.0.0"
    }
}
